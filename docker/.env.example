# 环境变量配置模板

# MySQL root 密码。
MYSQL_ROOT_PASSWORD=

# 数据库名。
MYSQL_DB=novus_api_router

# 业务用户名。
MYSQL_USERNAME=novus

# 业务用户密码。
MYSQL_PASSWORD=

# 千问平台 API Key 1。
QWEN_API_KEY_1=

# DeepSeek 平台 API Key 1。
DEEPSEEK_API_KEY_1=

# 千问 OpenAI 兼容 API 地址。
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1

# DeepSeek API 地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JWT 密钥，至少 32 字节。
JWT_SECRET=

# 可选：管理员用户 ID，仅管理员允许调用 增加测试余额 接口。多个用英文逗号分隔；留空表示没有管理员。
# 请按实际测试账号 ID 调整下方示例。
ADMIN_USER_IDS=1,2,3,4,5
